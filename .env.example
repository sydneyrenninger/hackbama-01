# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Current name. Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server-only (NEVER prefix with NEXT_PUBLIC_) ----
# Current name. Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM="Quad Exchange <verify@your-verified-domain.com>"
# 32+ random chars: openssl rand -base64 48
VERIFICATION_PEPPER=
# provision_pending (default) | reject
UNKNOWN_DOMAIN_POLICY=provision_pending

# ---- Demo seeding only (scripts/seed-demo.ts) ----
DEMO_USER_PASSWORD=
