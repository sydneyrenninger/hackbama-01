# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Anon / publishable key. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local: http://localhost:3000   Vercel: https://hackbama-01.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server-only (NEVER prefix with NEXT_PUBLIC_; mark Sensitive in Vercel) ----
# Supabase > Project Settings > API keys > secret (service_role). Used to create accounts.
SUPABASE_SECRET_KEY=
# 32+ random chars, used to hash rate-limit keys: openssl rand -base64 48
VERIFICATION_PEPPER=

# ---- Email (skipped for now: signup works without it; password reset doesn't) ----
# RESEND_API_KEY=
# EMAIL_FROM="Swapp <verify@your-verified-domain.com>"

# ---- Local only. Never add to Vercel or commit. ----
# npm run db:setup
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# npm run seed:demo -- --yes  (password for the qx-demo-* users)
DEMO_USER_PASSWORD=
